@{
    // Detectamos en qué controlador y acción está parado el navegador actualmente
    var controladorActual = ViewContext.RouteData.Values["Controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["Action"]?.ToString();
}

<aside class="sidebar-general">
    <div class="sidebar-header">
        <img src="~/images/logo-sigpro.svg" alt="Logo SIGPRO" class="sidebar-logo" />
        <h2>SIGPRO</h2>
        <span class="sidebar-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
    </div>

    <nav class="sidebar-menu">

        @if (User.IsInRole("Produccion"))
        {
            <a href="@Url.Action("Index", "Produccion")"
               class="@(controladorActual == "Produccion" ? "menu-activo" : "")">
                Módulo Producción
            </a>
        }

        @if (User.IsInRole("Compras"))
        {
            <!-- Acá corregimos la ruta para que apunte a Compras/Pedidos -->
            <a href="@Url.Action("Pedidos", "Compras")"
               class="@(controladorActual == "Compras" ? "menu-activo" : "")">
                Gestión de Pedidos
            </a>

            <a href="@Url.Action("Ordenes", "Compras")"
               class="@(controladorActual == "Compras" ? "menu-activo" : "")">
                Órdenes de Compra
            </a>
        }

        @if (User.IsInRole("Contabilidad"))
        {
            <a href="@Url.Action("Aprobaciones", "Contabilidad")"
               class="@(controladorActual == "Contabilidad" && accionActual == "Aprobaciones" ? "menu-activo" : "")">
                OC por Aprobar
            </a>
            <a href="@Url.Action("Pagos", "Contabilidad")"
               class="@(controladorActual == "Contabilidad" && accionActual == "Pagos" ? "menu-activo" : "")">
                OC por Pagar
            </a>
        }

        @if (User.IsInRole("Administracion"))
        {
            <a href="@Url.Action("Proveedores", "Admin")"
               class="@(controladorActual == "Admin" && accionActual == "Proveedores" ? "menu-activo" : "")">
                Proveedores
            </a>
            <a href="@Url.Action("Usuarios", "Admin")"
               class="@(controladorActual == "Admin" && accionActual == "Usuarios" ? "menu-activo" : "")">
                Usuarios
            </a>
            <a href="@Url.Action("Articulos", "Admin")"
               class="@(controladorActual == "Admin" && accionActual == "Articulos" ? "menu-activo" : "")">
                Artículos
            </a>
        }

    </nav>

    <div class="sidebar-footer">
        <a asp-controller="Acceso" asp-action="LogOut" onclick="return confirm('¿Estás seguro de que querés cerrar sesión en SIGPRO?');" class="btn-logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar Sesión
        </a>
    </div>
</aside>