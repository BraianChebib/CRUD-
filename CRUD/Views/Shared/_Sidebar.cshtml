@{
    // Detectamos en qué controlador y acción está parado el navegador actualmente
    var controladorActual = ViewContext.RouteData.Values["Controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["Action"]?.ToString();
}

<aside class="sidebar-general">
    <div class="sidebar-header">
        <img src="~/images/logo-sigpro.svg" alt="Logo SIGPRO" class="sidebar-logo" />
        <h2>SIGPRO</h2>
        <span class="sidebar-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
    </div>

    <nav class="sidebar-menu">

        @if (User.IsInRole("Produccion"))
        {
            <a href="@Url.Action("Index", "Produccion")"
               class="@(controladorActual == "Produccion" ? "menu-activo" : "")">
                Módulo Producción
            </a>
        }

        @if (User.IsInRole("Compras"))
        {
            // Apunta a PedidoController (pueden compartir controlador o filtrar por estado)
            <a href="@Url.Action("Index", "Pedido")"
               class="@(controladorActual == "Pedido" ? "menu-activo" : "")">
                Gestión de Pedidos
            </a>
            // Apunta a OrdenCompraController
            <a href="@Url.Action("Index", "OrdenCompra")"
               class="@(controladorActual == "OrdenCompra" ? "menu-activo" : "")">
                Órdenes de Compra
            </a>
        }

        @if (User.IsInRole("Contabilidad"))
        {
            // Como ambos procesos usan Órdenes de Compra, apuntan a OrdenCompraController
            // Usamos acciones distintas (que vas a crear después) para separar las listas
            <a href="@Url.Action("PendientesAprobacion", "OrdenCompra")"
               class="@(controladorActual == "OrdenCompra" && accionActual == "PendientesAprobacion" ? "menu-activo" : "")">
                OC por Aprobar
            </a>
            <a href="@Url.Action("PendientesPago", "OrdenCompra")"
               class="@(controladorActual == "OrdenCompra" && accionActual == "PendientesPago" ? "menu-activo" : "")">
                OC por Pagar
            </a>
        }

        @if (User.IsInRole("Administracion"))
        {
            // Apunta a ProveedorController
            <a href="@Url.Action("Index", "Proveedor")"
               class="@(controladorActual == "Proveedor" ? "menu-activo" : "")">
                Proveedores
            </a>
            // Apunta a UserController
            <a href="@Url.Action("Index", "User")"
               class="@(controladorActual == "User" ? "menu-activo" : "")">
                Usuarios
            </a>
            // Apunta a ArticuloController
            <a href="@Url.Action("Index", "Articulo")"
               class="@(controladorActual == "Articulo" ? "menu-activo" : "")">
                Artículos
            </a>
        }

    </nav>

    <div class="sidebar-footer">
        <a asp-controller="Acceso" asp-action="LogOut" onclick="return confirm('¿Estás seguro de que querés cerrar sesión en SIGPRO?');" class="btn-logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar Sesión
        </a>
    </div>
</aside>