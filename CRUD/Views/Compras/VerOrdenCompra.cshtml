@model CRUD.Models.OrdenCompra
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Mantiene tu menú lateral en la pantalla
    ViewData["Title"] = "Documento - Orden de Compra";
}

<div class="modulo-contenedor no-imprimir">
    <div class="barra-herramientas" style="justify-content: space-between; margin-bottom: 20px;">
        <a href="@Url.Action("Pedidos", "Compras")" class="btn-secundario">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Volver
        </a>
        <button onclick="window.print()" class="btn-principal" style="background-color: #0d6efd;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Imprimir / Guardar PDF
        </button>
    </div>
</div>

<!-- ESTE ES EL DOCUMENTO FÍSICO -->
<div class="hoja-a4">
    <div class="doc-header">
        <div class="empresa-info">
            <!-- Contenedor flex para alinear logo y texto uno al lado del otro -->
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 5px;">
                <!-- Reemplazá 'tu-logo.svg' por el nombre real de tu archivo -->
                <img src="~/images/Logo-Stoyko.svg" alt="Logo" style="max-height: 45px;" />
                <h1 style="margin: 0; color: #333; font-size: 28px;">STOYKO</h1>
            </div>
            
            <p style="margin: 0; color: #555;">Pisos y Revestimientos</p>
            <p style="margin: 0; color: #555;">CUIT: 30-11223344-5</p>
        </div>
        
        <div class="doc-titulo">
            <h2 style="margin: 0; color: #198754;">ORDEN DE COMPRA</h2>
            <h3 style="margin: 5px 0;">Nº OC-@Model.Id.ToString("D5")</h3>
            <p style="margin: 0; color: #555;">Fecha: @DateTime.Now.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <hr style="border-color: #ccc; margin: 20px 0;" />

    <div class="doc-datos">
        <div class="caja-datos">
            <strong>PROVEEDOR:</strong><br />
            Razón Social: @Model.Proveedor?.RazonSocial <br />
            CUIT: @Model.Proveedor?.Cuit <br />
            Contacto: @Model.Proveedor?.Mail
        </div>
        <div class="caja-datos">
            <strong>CONDICIONES:</strong><br />
            Fecha Estimada de Entrega: @Model.FechaEstimadaEntrega.ToString("dd/MM/yyyy") <br />
            Estado: <strong>@Model.Estado</strong> <br />
            Generado por: @Model.Usuario?.Nombre
        </div>
    </div>

    <table class="doc-tabla">
        <thead>
            <tr>
                <th>Código</th>
                <th>Descripción del Artículo</th>
                <th style="text-align: center;">Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.DetallesPedido != null)
            {
                foreach (var item in ViewBag.DetallesPedido)
                {
                    <tr>
                        <!-- Mostramos el ID del artículo como código -->
                        <td>ART-@item.ArticuloId.ToString("D3")</td>
                        <td>@(item.Articulo != null ? item.Articulo.Nombre : "Artículo sin nombre")</td>
                        <td style="text-align: center;">@item.Cantidad</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" style="text-align: center; color: #888;">Sin detalles registrados.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="doc-total">
        <h3>TOTAL: $@Model.Total.ToString("N2", new System.Globalization.CultureInfo("es-AR"))</h3>
    </div>

    <div class="doc-firmas">
        <div class="firma-caja">
            <hr />
            Firma Comprador (SIGPRO)
        </div>
        <div class="firma-caja">
            <hr />
            Firma Proveedor / Aceptación
        </div>
    </div>
</div>

<style>
    /* Diseño de la hoja en pantalla */
    .hoja-a4 {
        background-color: white;
        color: black;
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 0 auto 2cm auto;
        box-shadow: 0 0 15px rgba(0,0,0,0.2);
        font-family: Arial, sans-serif;
    }

    .doc-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .doc-titulo {
        text-align: right;
    }

    .doc-datos {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
    }

    .caja-datos {
        width: 48%;
        padding: 15px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        line-height: 1.6;
    }

    .doc-tabla {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

        .doc-tabla th, .doc-tabla td {
            border: 1px solid #333;
            padding: 10px;
            text-align: left;
        }

        .doc-tabla th {
            background-color: #f1f1f1;
        }

    .doc-total {
        text-align: right;
        padding: 15px;
        border: 2px solid #333;
        background-color: #f8f9fa;
        margin-bottom: 50px;
    }

    .doc-firmas {
        display: flex;
        justify-content: space-around;
        margin-top: 80px;
    }

    .firma-caja {
        width: 30%;
        text-align: center;
        font-size: 0.9em;
        color: #555;
    }

        .firma-caja hr {
            border-color: #333;
            margin-bottom: 5px;
        }

    /* REGLA MÁGICA PARA IMPRIMIR */
    @@media print {
        body {
            background-color: white;
        }
        /* Ocultar menú lateral, barras, botones y todo lo que no sea el documento */
        .no-imprimir, aside, nav, header, footer {
            display: none !important;
        }
        /* Quitar la sombra y márgenes para que encaje perfecto en el papel físico */
        .hoja-a4 {
            box-shadow: none;
            margin: 0;
            padding: 0;
            width: 100%;
        }
    }
</style>