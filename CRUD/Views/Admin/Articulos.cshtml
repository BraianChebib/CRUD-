@model IEnumerable<CRUD.Models.Articulo>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Artículos - SIGPRO";
}

<div class="modulo-contenedor">
    <div class="modulo-header">
        <h1>Artículos</h1>
    </div>

    <div class="barra-herramientas">
        <div class="buscador-wrapper">
            <svg class="buscador-icono" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="tabla-buscador" placeholder="Buscar por nombre, descripción o unidad..." autocomplete="off" />
        </div>

        <div class="acciones-wrapper">
            <button id="btn-eliminar" class="btn-secundario" disabled style="border-color: #F87171; color: #F87171;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                Eliminar
            </button>

            <button id="btn-modificar" class="btn-secundario" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"></path></svg>
                Modificar
            </button>

            <a href="@Url.Action("CrearArticulo", "Admin")" class="btn-principal">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Nuevo Artículo
            </a>
        </div>
    </div>

    <div class="tabla-tarjeta">
        <table class="tabla-sigpro" id="tabla-articulos">
            <thead>
                <tr>
                    <th class="col-id ordenable" data-columna="id">Id <span class="flecha-orden"></span></th>
                    <th class="col-nombre ordenable" data-columna="nombre">Nombre <span class="flecha-orden"></span></th>
                    <th class="col-descripcion ordenable" data-columna="descripcion">Descripción <span class="flecha-orden"></span></th>
                    <th class="col-unidad ordenable" data-columna="unidad">Unidad de Medida <span class="flecha-orden"></span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr data-id="@a.Id" data-nombre="@a.Nombre">
                        <td class="col-id"><strong>#@a.Id.ToString("D3")</strong></td>
                        <td class="col-nombre">@a.Nombre</td>
                        <td class="col-descripcion">@a.Descripcion</td>
                        <td class="col-unidad">@a.UnidadMedida</td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="sin-resultados" class="tabla-vacia" style="display: none;">
            No se encontraron artículos que coincidan con la búsqueda.
        </div>
    </div>
</div>

<!-- Pop-up de confirmación -->
<div id="modal-eliminar" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div class="tabla-tarjeta" style="max-width: 420px; width: 90%; padding: 24px; text-align: center;">
        <h3 style="margin-bottom: 12px; color: #F87171;">¿Eliminar Artículo?</h3>
        <p style="margin-bottom: 20px;">
            Estás por eliminar permanentemente <strong id="modal-nombre-item"></strong> de la lista activa.
            Los pedidos y órdenes históricas no se verán afectados.
        </p>
        <form method="post" action="@Url.Action("EliminarArticulo", "Admin")" style="display:flex; gap:12px; justify-content:center;">
            <input type="hidden" name="id" id="modal-id-item" />
            <button type="button" id="btn-cancelar-modal" class="btn-secundario">Cancelar</button>
            <button type="submit" class="btn-principal" style="background-color: #DC2626;">Sí, Eliminar</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabla = document.getElementById("tabla-articulos");
            const tbody = tabla.querySelector("tbody");
            const btnModificar = document.getElementById("btn-modificar");
            const btnEliminar = document.getElementById("btn-eliminar");
            const buscador = document.getElementById("tabla-buscador");
            const sinResultados = document.getElementById("sin-resultados");
            const cabeceras = tabla.querySelectorAll("th.ordenable");

            const modal = document.getElementById("modal-eliminar");
            const modalNombre = document.getElementById("modal-nombre-item");
            const modalId = document.getElementById("modal-id-item");
            const btnCancelarModal = document.getElementById("btn-cancelar-modal");

            let idSeleccionado = null;
            let nombreSeleccionado = "";
            let ordenDireccion = {};

            function actualizarBotones(habilitar) {
                btnModificar.disabled = !habilitar;
                btnEliminar.disabled = !habilitar;
            }

            tbody.querySelectorAll("tr").forEach(fila => {
                fila.addEventListener("click", function () {
                    if (this.classList.contains("fila-seleccionada")) {
                        this.classList.remove("fila-seleccionada");
                        idSeleccionado = null;
                        nombreSeleccionado = "";
                        actualizarBotones(false);
                    } else {
                        tbody.querySelectorAll("tr").forEach(f => f.classList.remove("fila-seleccionada"));
                        this.classList.add("fila-seleccionada");
                        idSeleccionado = this.getAttribute("data-id");
                        nombreSeleccionado = this.getAttribute("data-nombre");
                        actualizarBotones(true);
                    }
                });

                fila.addEventListener("dblclick", function () {
                    const id = this.getAttribute("data-id");
                    window.location.href = `/Admin/EditarArticulo/${id}`;
                });
            });

            btnModificar.addEventListener("click", () => {
                if (idSeleccionado) window.location.href = `/Admin/EditarArticulo/${idSeleccionado}`;
            });

            btnEliminar.addEventListener("click", () => {
                if (idSeleccionado) {
                    modalId.value = idSeleccionado;
                    modalNombre.textContent = nombreSeleccionado;
                    modal.style.display = "flex";
                }
            });

            btnCancelarModal.addEventListener("click", () => modal.style.display = "none");

            buscador.addEventListener("input", function () {
                const termino = this.value.toLowerCase().trim();
                const filas = Array.from(tbody.querySelectorAll("tr"));
                let visibles = 0;

                filas.forEach(fila => {
                    if (fila.textContent.toLowerCase().includes(termino)) {
                        fila.style.display = "";
                        visibles++;
                    } else {
                        fila.style.display = "none";
                        if (fila.classList.contains("fila-seleccionada")) {
                            fila.classList.remove("fila-seleccionada");
                            idSeleccionado = null;
                            actualizarBotones(false);
                        }
                    }
                });

                sinResultados.style.display = visibles === 0 ? "block" : "none";
            });

            cabeceras.forEach(cabecera => {
                cabecera.addEventListener("click", function () {
                    const columna = this.getAttribute("data-columna");
                    const filas = Array.from(tbody.querySelectorAll("tr"));
                    let direccion = ordenDireccion[columna] === "asc" ? "desc" : "asc";
                    ordenDireccion = { [columna]: direccion };

                    cabeceras.forEach(th => th.classList.remove("orden-asc", "orden-desc"));
                    this.classList.add(direccion === "asc" ? "orden-asc" : "orden-desc");

                    filas.sort((a, b) => {
                        let valA = a.querySelector(`.col-${columna}`)?.textContent.trim() || "";
                        let valB = b.querySelector(`.col-${columna}`)?.textContent.trim() || "";

                        if (columna === "id") {
                            valA = parseInt(valA.replace(/[^0-9]/g, ''), 10);
                            valB = parseInt(valB.replace(/[^0-9]/g, ''), 10);
                            return direccion === "asc" ? valA - valB : valB - valA;
                        }
                        return direccion === "asc" ? valA.localeCompare(valB) : valB.localeCompare(valA);
                    });

                    filas.forEach(f => tbody.appendChild(f));
                });
            });
        });
    </script>
}