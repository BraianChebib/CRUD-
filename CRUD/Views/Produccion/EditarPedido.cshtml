@model CRUD.Models.Pedido

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Modificar Pedido #{Model.Id:D4} - SIGPRO";
    var articulosDisponibles = ViewBag.ArticulosDisponibles as IEnumerable<CRUD.Models.Articulo> ?? new List<CRUD.Models.Articulo>();

    string claseBadge = Model.Estado switch
    {
        "Aprobado" => "badge-produccion",
        "Pendiente" => "badge-pendiente",
        "Completado" => "badge-completado",
        "Rechazado" => "badge-rechazado",
        _ => "badge-revision"
    };

    // Evaluamos si el pedido está en un estado que permita modificaciones operativas
    bool esEditable = Model.Estado == "Pendiente";
}

<div class="modulo-contenedor">
    <div class="modulo-header">
        <h1>Modificar Pedido <span class="pedido-id">#PD-@Model.Id.ToString("D4")</span></h1>
    </div>

    <div class="tabla-tarjeta" style="padding: 24px; margin-bottom: 24px; display: flex; gap: 40px; flex-wrap: wrap;">
        <div>
            <span style="color: var(--texto-secundario); font-size: 0.8rem; text-transform: uppercase; display: block; margin-bottom: 6px;">Responsable</span>
            <strong style="color: var(--texto-primario); font-size: 1.1rem;">@Model.Usuario?.Nombre</strong>
        </div>
        <div>
            <span style="color: var(--texto-secundario); font-size: 0.8rem; text-transform: uppercase; display: block; margin-bottom: 6px;">Fecha de Creación</span>
            <strong style="color: var(--texto-primario); font-size: 1.1rem;">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</strong>
        </div>
        
        <div>
            <span style="color: var(--texto-secundario); font-size: 0.8rem; text-transform: uppercase; display: block; margin-bottom: 6px;">Última Modificación</span>
            <strong style="color: var(--texto-primario); font-size: 1.1rem;">
               @(Model.UltimaModificacion.HasValue ? Model.UltimaModificacion.Value.ToString("dd/MM/yyyy HH:mm") : "-")
            </strong>
        </div>

        <div>
            <span style="color: var(--texto-secundario); font-size: 0.8rem; text-transform: uppercase; display: block; margin-bottom: 6px;">Estado Actual</span>
            <span class="badge @claseBadge">@Model.Estado</span>
        </div>
    </div>

    @if (esEditable)
    {
        <div class="tabla-tarjeta" style="padding: 24px; margin-bottom: 24px; overflow: visible !important;">
            <h3 style="font-size: 0.9rem; text-transform: uppercase; color: var(--texto-secundario); margin-bottom: 16px; letter-spacing: 0.5px;">Agregar o Modificar Artículos</h3>

            <div style="display: flex; gap: 16px; align-items: flex-end; position: relative; overflow: visible !important;">
                <div style="flex: 1; position: relative;">
                    <label style="color: var(--texto-secundario); font-size: 0.8rem; display: block; margin-bottom: 8px;">Buscar Artículo nuevo</label>
                    <input type="text" id="input-articulo" class="buscador-wrapper" style="padding: 11px 16px; width: 100%; max-width: unset;" placeholder="Escriba para agregar otro artículo al pedido..." autocomplete="off" />

                    <div id="dropdown-articulos" style="position: absolute; width: 100%; top: 68px; left: 0; z-index: 99999; max-height: 200px; overflow-y: auto; display: none; box-shadow: 0 10px 30px rgba(0,0,0,0.8); background-color: #1e2e25 !important; border: 1px solid rgba(255,255,255,0.2); border-radius: 4px;">
                    </div>
                </div>

                <div style="width: 140px;">
                    <label style="color: var(--texto-secundario); font-size: 0.8rem; display: block; margin-bottom: 8px;">Cantidad</label>
                    <input type="number" id="input-cantidad" class="buscador-wrapper" style="padding: 11px 16px; width: 100%; text-align: center;" min="1" step="1" value="1" />
                </div>

                <button type="button" id="btn-agregar-lista" class="btn-principal" style="height: 44px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Agregar
                </button>
            </div>
        </div>
    }

    <div class="tabla-tarjeta">
        <table class="tabla-sigpro" id="tabla-detalles">
            <thead>
                <tr>
                    <th style="width: 150px;">Código Art.</th>
                    <th>Descripción del Artículo</th>
                    <th style="width: 150px; text-align: center;">Cantidad</th>
                    <th style="width: 100px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                </tbody>
        </table>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 16px; margin-top: 24px;">
        @if (esEditable)
        {
            <a href="@Url.Action("Index", "Produccion")" class="btn-secundario">Cancelar modificaciones</a>
            <button type="button" id="btn-guardar-pedido" class="btn-principal">Guardar Cambios</button>
        }
        else
        {
            <a href="@Url.Action("Index", "Produccion")" class="btn-principal">Volver al listado</a>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            const articulosDisibles = [
                @foreach (var art in articulosDisponibles) {
                    <text>{ id: @art.Id, nombre: "@Html.Raw(art.Nombre)", unidad: "@Html.Raw(art.UnidadMedida)" },</text>
                }
            ];

            const inputArticulo = document.getElementById("input-articulo");
            const dropdown = document.getElementById("dropdown-articulos");
            const inputCantidad = document.getElementById("input-cantidad");
            const btnAgregar = document.getElementById("btn-agregar-lista");
            const tablaDetalles = document.getElementById("tabla-detalles").querySelector("tbody");
            const btnGuardar = document.getElementById("btn-guardar-pedido");

            let articuloSeleccionado = null;

            let listaDetallesTemp = [
                @foreach (var det in Model.Detalles) {
                    <text>{
                        articuloId: @det.ArticuloId,
                        nombre: "@Html.Raw(det.Articulo?.Nombre ?? "Artículo Desconocido")",
                        unidad: "@Html.Raw(det.Articulo?.UnidadMedida ?? "U.")",
                        cantidad: @det.Cantidad.ToString().Replace(",", ".")
                    },</text>
                }
            ];

            renderizarTabla();

            // Solo bindeamos eventos de búsqueda si el panel existe en el DOM
            if (inputArticulo) {
                inputArticulo.addEventListener("input", function () {
                    const termino = this.value.toLowerCase().trim();
                    dropdown.innerHTML = "";
                    articuloSeleccionado = null;

                    if (termino.length === 0) {
                        dropdown.style.display = "none";
                        return;
                    }

                    const coincidencias = articulosDisibles.filter(a => a.nombre.toLowerCase().includes(termino));

                    if (coincidencias.length === 0) {
                        dropdown.innerHTML = `<div class="tabla-vacia" style="padding: 12px; color: var(--texto-secundario);">No se encontraron artículos</div>`;
                        dropdown.style.display = "block";
                        return;
                    }

                    coincidencias.forEach(art => {
                        const item = document.createElement("div");
                        item.style.padding = "12px 16px";
                        item.style.cursor = "pointer";
                        item.style.color = "var(--texto-secundario)";
                        item.style.borderBottom = "1px solid rgba(255, 255, 255, 0.08)";
                        item.innerHTML = `<strong style="color: var(--texto-primario);">${art.nombre}</strong> <span style="font-size: 0.8rem; margin-left: 8px;">(${art.unidad})</span>`;

                        item.addEventListener("click", function () {
                            inputArticulo.value = art.nombre;
                            articuloSeleccionado = art;
                            dropdown.style.display = "none";
                            inputCantidad.focus();
                        });

                        dropdown.appendChild(item);
                    });

                    dropdown.style.display = "block";
                });

                document.addEventListener("click", function (e) {
                    if (e.target !== inputArticulo && e.target !== dropdown) {
                        dropdown.style.display = "none";
                    }
                });
            }

            if (btnAgregar) {
                btnAgregar.addEventListener("click", function () {
                    const cantidad = parseFloat(inputCantidad.value);

                    if (!articuloSeleccionado) {
                        alert("Por favor, seleccione un artículo válido de la lista desplegable.");
                        return;
                    }
                    if (isNaN(cantidad) || cantidad <= 0) {
                        alert("Por favor, ingrese una cantidad mayor a cero.");
                        return;
                    }

                    const existe = listaDetallesTemp.find(d => d.articuloId === articuloSeleccionado.id);
                    if (existe) {
                        existe.cantidad += cantidad;
                    } else {
                        listaDetallesTemp.push({
                            articuloId: articuloSeleccionado.id,
                            nombre: articuloSeleccionado.nombre,
                            unidad: articuloSeleccionado.unidad,
                            cantidad: cantidad
                        });
                    }

                    renderizarTabla();

                    inputArticulo.value = "";
                    inputCantidad.value = "1";
                    articuloSeleccionado = null;
                    inputArticulo.focus();
                });
            }

            function renderizarTabla() {
                tablaDetalles.innerHTML = "";

                if (listaDetallesTemp.length === 0) {
                    tablaDetalles.innerHTML = `<tr><td colspan="4" class="tabla-vacia">El pedido no tiene artículos.</td></tr>`;
                    if (btnGuardar) btnGuardar.disabled = true;
                    return;
                }

                if (btnGuardar) btnGuardar.disabled = false;
                const esEditableJS = "@esEditable".toLowerCase() === "true";

                listaDetallesTemp.forEach((item, index) => {
                    const tr = document.createElement("tr");
                    const idFormateado = item.articuloId.toString().padStart(4, '0');
                    
                    // Condicionamos visualmente la celda de acciones en base al estado del pedido
                    const celdaAcciones = esEditableJS 
                        ? `<button type="button" style="background: transparent; color: #ff6b6b; border: 1px solid rgba(255, 107, 107, 0.4); padding: 4px 12px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; font-family: inherit;" onclick="eliminarItemTemporal(${index})">Eliminar</button>`
                        : `<span style="color: var(--texto-secundario); font-size: 0.85rem;">Bloqueado</span>`;

                    tr.innerHTML = `
                        <td class="col-id"><span class="pedido-id">#ART-${idFormateado}</span></td>
                        <td style="color: var(--texto-primario); text-align: left;">${item.nombre}</td>
                        <td style="text-align: center; font-family: var(--fuente-datos); color: var(--acento-verde); font-weight: bold;">${item.cantidad.toFixed(2)} <span style="font-size: 0.75rem; color: var(--texto-secundario); font-weight: normal;">${item.unidad}</span></td>
                        <td style="text-align: center;">${celdaAcciones}</td>
                    `;
                    tablaDetalles.appendChild(tr);
                });
            }

            window.eliminarItemTemporal = function(index) {
                listaDetallesTemp.splice(index, 1);
                renderizarTabla();
            };

            if (btnGuardar) {
                btnGuardar.addEventListener("click", function () {
                    if (listaDetallesTemp.length === 0) return;

                    const pedidoModificadoData = {
                        pedidoId: @Model.Id,
                        detalles: listaDetallesTemp.map(item => ({
                            articuloId: item.articuloId,
                            cantidad: item.cantidad
                        }))
                    };

                    btnGuardar.disabled = true;
                    btnGuardar.textContent = "Actualizando...";

                    fetch('/Produccion/ActualizarPedido', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(pedidoModificadoData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert("¡Pedido actualizado con éxito!");
                            window.location.href = '/Produccion/Index';
                        } else {
                            alert("Error: " + data.mensaje);
                            btnGuardar.disabled = false;
                            btnGuardar.textContent = "Guardar Cambios";
                        }
                    })
                    .catch(error => {
                        console.error("Error al actualizar:", error);
                        alert("Error de comunicación con el servidor.");
                        btnGuardar.disabled = false;
                        btnGuardar.textContent = "Guardar Cambios";
                    });
                });
            }
        });
    </script>
}